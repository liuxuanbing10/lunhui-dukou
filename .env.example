# ===== 轮回渡口 环境变量模板 =====
# 复制为 .env 并填写真实值。禁止提交 .env。

# ---- LLM Provider（多 provider 容灾：主 + 备 + 兜底）----
# 主 provider（opencode-go 或任意 OpenAI 兼容端点）
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=

# 备用 provider
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# 兜底（免费网关等）
LLM_LAST_RESORT_BASE_URL=
LLM_LAST_RESORT_API_KEY=
LLM_LAST_RESORT_MODEL=

# ---- Server ----
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# ---- 数据 ----
# SQLite 数据库文件位置（相对 server 包根目录）
DB_PATH=./data/lunhui.db
