# ===== 轮回渡口 环境变量模板 =====
# 复制为 .env 并填写真实值。禁止提交 .env。

# ---- LLM Provider（多 provider 容灾：主 sophnet + 备 deepseek + 保守兜底）----
# 主 provider：sophnet（OpenAI 兼容端点，免费额度）
SOPHNET_API_KEY=

# 备用 provider：DeepSeek 官方（¥1/2M tokens）
DEEPSEEK_API_KEY=

# ---- LLM 容灾调参（cockatiel：timeout + retry + 熔断，见 llm-generator.ts）----
# 单次调用超时 ms（默认 15000；挂起的 provider 会被斩断）
LLM_TIMEOUT_MS=15000
# 单 provider 最大尝试次数（默认 2 = 首试 + 1 次重试）
LLM_MAX_ATTEMPTS=2
# 连续失败 N 次后熔断该 provider（默认 3）
LLM_BREAKER_THRESHOLD=3
# 熔断后多久试探恢复 ms（默认 30000）
LLM_BREAKER_HALF_OPEN_MS=30000

# ---- Server ----
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# JWT 签名密钥（桌面客户端多玩家鉴权，见 DESKTOP_MIGRATION.md Phase 1）
# 生产环境必填；开发缺省用内置默认值
JWT_SECRET=

# ---- 限流（Phase 1，按玩家/IP，防滥用与防烧穿 LLM 预算）----
# /api/ask：每个玩家每分钟最大请求数
RATE_LIMIT_ASK_MAX=20
RATE_LIMIT_ASK_WINDOW_MS=60000
# 登录：每个 IP 每分钟最大尝试次数（防爆破）
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
# LLM 调用：每个玩家每分钟最大调用次数
RATE_LIMIT_LLM_MAX=30
RATE_LIMIT_LLM_WINDOW_MS=60000

# ---- 数据 ----
# SQLite 数据库文件位置（相对 server 包根目录）
DB_PATH=./data/lunhui.db
