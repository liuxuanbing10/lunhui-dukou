{
  "name": "lunhui-dukou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "轮回渡口 - AI 推理互动叙事（海龟汤 × 狼人杀 × 活小镇）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@lunhui/web",
    "dev:server": "npm run dev --workspace=@lunhui/server",
    "dev:engine": "npm run dev --workspace=@lunhui/engine",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:web": "npm run test -w @lunhui/web",
    "test:engine": "npm run test -w @lunhui/engine",
    "test:server": "npm run test -w @lunhui/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "changeset": "changesets",
    "version": "changesets version",
    "release": "changesets version && npm run build",
    "publish": "changesets publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
