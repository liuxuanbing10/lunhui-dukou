<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Godot.NET.Sdk 4.8.0-dev.3 是 dev 版，不上 nuget.org，只能用编辑器自带的本地包源。
      该路径随本机 Godot mono build 固定（docs/DESKTOP_MIGRATION.md 工具盘点）。
    -->
    <add key="local-godot-sdk" value="D:\tools\Godot_v4.8-dev3_mono_win64\GodotSharp\Tools\nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>