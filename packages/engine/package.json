{
  "name": "@lunhui/engine",
  "version": "0.1.0",
  "private": true,
  "description": "轮回渡口 - AI 生成引擎（骨架预设 + 血肉生成 + 因果回流）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./truth": {
      "types": "./dist/truth.d.ts",
      "import": "./dist/truth.js",
      "require": "./dist/truth.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./death-lines": {
      "types": "./dist/death-lines.d.ts",
      "import": "./dist/death-lines.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build:browser-data": "node scripts/build-browser-data.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.1"
  }
}
